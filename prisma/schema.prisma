// ============================================================================
// SupportFlow — Multi-Tenant Client Feedback & Support Portal
// ============================================================================
// Production-ready Prisma schema.
//
// This schema is the single source of truth. It was reconciled against the
// application code (which was previously drifting): models, fields and enum
// values below are exactly what the NestJS services read and write.
//
// Conventions:
//   * Every model uses `String @id @default(cuid())`.
//   * Every model carries `createdAt` / `updatedAt` audit timestamps.
//   * Every tenant-scoped model carries `organizationId` + an Organization
//     relation. Platform-level records (system settings, platform templates,
//     global announcements) intentionally have `organizationId` nullable.
//   * FK/status/email/timestamp columns are indexed for tenant-isolated reads.
//   * Referential actions are explicit: tenant deletion cascades, while
//     history/audit rows use SetNull to stay immutable.
// ============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

