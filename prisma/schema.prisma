// ==================================================
// ORGANIZATION & USERS
// ==================================================

model Organization {
  id                   String               @id @default(cuid())
  name                 String
  slug                 String               @unique
  tenantKey            String               @unique
  website              String?
  logo                 String?
  billingEmail         String?
  timezone             String               @default("UTC")
  locale               String               @default("en-US")
  status               OrganizationStatus   @default(ACTIVE)
  isVerified           Boolean              @default(false)
  inviteCode           String?              @unique
  inviteLink           String?              @unique
  metadata             Json?
  currentSubscriptionId String?
  trialEndsAt          DateTime?
  deletedAt            DateTime?
  deletedById          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  settings             OrganizationSettings?
  users                User[]
  departments          Department[]
  tickets              Ticket[]
  feedbackForms        FeedbackForm[]
  feedbackResponses    FeedbackResponse[]
  feedbackRequests     FeedbackRequest[]
  notifications        Notification[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
  subscriptions        OrganizationSubscription[]
  usageRecords         UsageRecord[]
  fileUploads          FileUpload[]
  loginHistory         LoginHistory[]
  apiKeys              ApiKey[]
  announcements        Announcement[]
  savedReports         SavedReport[]
  ticketTags           Tag[]
  ticketCategories     TicketCategory[]
  feedbackCategories   FeedbackCategory[]
  knowledgeCategories  KnowledgeCategory[]
  knowledgeArticles    KnowledgeArticle[]
  slaPolicies          SLAPolicy[]
  businessHours        BusinessHours[]
  holidays             Holiday[]
  organizationInviteLinks OrganizationInviteLink[]
  evidence             Evidence[]
  knowledgeTags        KnowledgeTag[]
  payments             Payment[]
  invoices             Invoice[]
  notificationTemplates NotificationTemplate[]

  @@index([slug])
  @@index([tenantKey])
  @@index([status])
  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationSettings {
  id                     String       @id @default(cuid())
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultLanguage        Language     @default(EN)
  defaultTheme           ThemeMode    @default(LIGHT)
  timezone               String       @default("UTC")
  dateFormat             String       @default("MM/DD/YYYY")
  ticketAutoAssignment   Boolean      @default(false)
  ticketAutoCloseDays    Int          @default(7)
  feedbackAutoRequest    Boolean      @default(true)
  notificationEmail      String?
  supportEmail           String?
  supportPhone           String?
  customCSS              String?

  // Customer Portal Settings
  allowPublicTickets     Boolean      @default(false)
  allowAnonymousFeedback Boolean      @default(true)
  branding               String?
  portalTheme            String       @default("default")
  portalLogo             String?
  portalFooter           String?
  knowledgeBaseEnabled   Boolean      @default(true)

  // Organization Branding
  primaryColor           String?      @default("#3B82F6")
  secondaryColor         String?      @default("#6366F1")
  brandLogo              String?
  brandFavicon           String?
  emailBranding          String?
  portalTitle            String?

  // Feedback Settings
  feedbackRequestDelayHours Int       @default(24)
  maxFeedbackRequests    Int          @default(3)
  defaultFeedbackFormId  String?
  maxAttachmentSizeMb    Int?

  // SLA Settings
  defaultSLAId           String?

  metadata               Json?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@map("organization_settings")
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  password             String
  firstName            String
  lastName             String
  phone                String?
  avatarUrl            String?
  role                 UserRole             @default(CUSTOMER)
  status               UserStatus           @default(PENDING_VERIFICATION)
  organizationId       String?
  organization         Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  lastLoginAt          DateTime?
  emailVerifiedAt      DateTime?
  preferences          Json?
  metadata             Json?
  deletedAt            DateTime?
  deletedById          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  refreshTokens        RefreshToken[]
  sessions             UserSession[]
  emailVerification    EmailVerificationToken?
  passwordResets       PasswordResetToken[]
  createdTickets       Ticket[]             @relation("TicketCreatedBy")
  assignedTickets      Ticket[]             @relation("TicketAssignedTo")
  ticketReplies        TicketReply[]
  ticketActivities     TicketActivity[]
  ticketWatchers       TicketWatcher[]
  ticketAttachments    TicketAttachment[]
  ticketFeedback       TicketFeedback[]
  feedbackForms        FeedbackForm[]       @relation("FeedbackFormCreatedBy")
  feedbackResponses    FeedbackResponse[]   @relation("FeedbackResponseSubmittedBy")
  feedbackRequests     FeedbackRequest[]    @relation("FeedbackRequestSubmittedBy")
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  notificationSettings NotificationSettings[]
  notificationTemplates NotificationTemplate[] @relation("TemplateCreatedBy")
  auditLogs            AuditLog[]           @relation("AuditActor")
  loginHistory         LoginHistory[]
  fileUploads          FileUpload[]
  apiKeys              ApiKey[]
  invitations          Invitation[]         @relation("InvitedBy")
  acceptedInvitations  Invitation[]         @relation("AcceptedBy")
  savedReports         SavedReport[]
  departmentMemberships DepartmentMember[]
  knowledgeArticles    KnowledgeArticle[]   @relation("ArticleCreatedBy")
  knowledgeArticleUpdates KnowledgeArticle[] @relation("ArticleUpdatedBy")
  knowledgeArticleFeedback KnowledgeArticleFeedback[]
  slaPolicies          SLAPolicy[]          @relation("SLACreatedBy")
  slaPolicyUpdates     SLAPolicy[]          @relation("SLAUpdatedBy")
  organizationInviteLinks OrganizationInviteLink[]
  announcements        Announcement[]       @relation("AnnouncementCreatedBy")
  evidence             Evidence[]           @relation("EvidenceUploadedBy")

  @@index([email])
  @@index([organizationId])
  @@index([role])
  @@index([status])
  @@index([organizationId, role])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id                   String         @id @default(cuid())
  token                String         @unique
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSession {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken         String         @unique
  ipAddress            String?
  userAgent            String?
  deviceInfo           String?
  location             String?
  expiresAt            DateTime
  invalidatedAt        DateTime?
  lastActivityAt       DateTime
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("user_sessions")
}

model EmailVerificationToken {
  id                   String         @id @default(cuid())
  token                String         @unique
  userId               String         @unique
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt            DateTime
  usedAt               DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id                   String         @id @default(cuid())
  token                String         @unique
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt            DateTime
  usedAt               DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Invitation {
  id                   String           @id @default(cuid())
  token                String           @unique
  email                String
  role                 UserRole         @default(CUSTOMER)
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById          String
  invitedBy            User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedById         String?
  acceptedBy           User?            @relation("AcceptedBy", fields: [acceptedById], references: [id])
  status               InvitationStatus @default(PENDING)
  expiresAt            DateTime
  acceptedAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([email, organizationId, status])
  @@index([token])
  @@index([email])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("invitations")
}

model OrganizationInviteLink {
  id                   String           @id @default(cuid())
  code                 String           @unique
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById          String
  createdBy            User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  role                 UserRole         @default(CUSTOMER)
  expiresAt            DateTime
  maxUses              Int              @default(1)
  usedCount            Int              @default(0)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([code])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("organization_invite_links")
}

model Permission {
  id                   String         @id @default(cuid())
  code                 PermissionCode @unique
  description          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  roles                RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id                   String         @id @default(cuid())
  role                 UserRole
  permissionId         String
  permission           Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==================================================
// DEPARTMENTS
// ==================================================

model Department {
  id                   String         @id @default(cuid())
  name                 String
  description          String?
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId             String?
  parent               Department?    @relation("DepartmentParent", fields: [parentId], references: [id])
  children             Department[]   @relation("DepartmentParent")
  isActive             Boolean        @default(true)
  metadata             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  members              DepartmentMember[]
  tickets              Ticket[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([parentId])
  @@map("departments")
}

model DepartmentMember {
  id                   String         @id @default(cuid())
  departmentId         String
  department           Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  isManager            Boolean        @default(false)
  joinedAt             DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([departmentId, userId])
  @@index([departmentId])
  @@index([userId])
  @@map("department_members")
}

// ==================================================
// TICKETS
// ==================================================

model TicketCategory {
  id                   String         @id @default(cuid())
  name                 String
  color                String?
  description          String?
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tickets              Ticket[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("ticket_categories")
}

model Ticket {
  id                   String           @id @default(cuid())
  ticketNumber         String
  subject              String
  description          String?
  status               TicketStatus     @default(OPEN)
  priority             TicketPriority   @default(MEDIUM)
  source               TicketSource     @default(PORTAL)
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             TicketCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  departmentId         String?
  department           Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdById          String
  createdBy            User             @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignedToId         String?
  assignedTo           User?            @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedAt           DateTime?
  resolvedById         String?
  closedAt             DateTime?
  closedById           String?
  dueAt                DateTime?
  firstRespondedAt     DateTime?
  firstResponseDueAt   DateTime?
  resolutionDueAt      DateTime?
  lastActivityAt       DateTime?
  closedReason         String?
  reopenedCount        Int              @default(0)
  internalNotes        String?
  feedbackRequestedAt  DateTime?
  feedbackSubmittedAt  DateTime?
  metadata             Json?
  deletedAt            DateTime?
  deletedById          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  replies              TicketReply[]
  attachments          TicketAttachment[]
  activities           TicketActivity[]
  watchers             TicketWatcher[]
  ticketTags           TicketTag[]
  slaHistory           TicketSLAHistory[]
  evidence             Evidence[]
  feedback             TicketFeedback?
  feedbackResponses    FeedbackResponse[]
  feedbackRequests     FeedbackRequest[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId])
  @@index([ticketNumber])
  @@index([createdById])
  @@index([assignedToId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@index([organizationId, createdAt])
  @@index([organizationId, priority])
  @@index([deletedAt])
  @@map("tickets")
}

model Tag {
  id                   String         @id @default(cuid())
  name                 String
  color                String?
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  assignments          TicketTag[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("tags")
}

model TicketTag {
