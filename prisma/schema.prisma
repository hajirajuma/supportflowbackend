  resolutionTime       Int?
  metadata             Json?
  submittedAt          DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([ticketId])
  @@index([organizationId])
  @@index([submittedById])
  @@map("ticket_feedback")
}

// ==================================================
// EVIDENCE
// ==================================================

model Evidence {
