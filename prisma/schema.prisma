  firstResponseDue     DateTime?
  resolutionDue        DateTime?
  firstResponseAt      DateTime?
  resolvedAt           DateTime?
  isBreached           Boolean        @default(false)
  breachReason         String?
  warningSentAt        DateTime?
  breachedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([ticketId])
  @@index([slaPolicyId])
  @@map("ticket_sla_history")
}

// ==================================================
// FEEDBACK
// ==================================================

model FeedbackCategory {
  id                   String         @id @default(cuid())
  name                 String
  description          String?
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId             String?
  parent               FeedbackCategory? @relation("CategoryParent", fields: [parentId], references: [id])
  children             FeedbackCategory[] @relation("CategoryParent")
  order                Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  forms                FeedbackForm[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("feedback_categories")
}

model FeedbackForm {
  id                   String             @id @default(cuid())
  title                String
  slug                 String?
  description          String?
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             FeedbackCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdById          String
  createdBy            User               @relation("FeedbackFormCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  status               FeedbackFormStatus @default(DRAFT)
  isPublic             Boolean            @default(false)
  allowAnonymous       Boolean            @default(false)
  notifyByEmail        Boolean            @default(false)
  welcomeMessage       String?
  thankYouMessage      String?
  redirectUrl          String?
  publishedAt          DateTime?
  expiresAt            DateTime?
  isSatisfactionSurvey Boolean            @default(false)
  allowMultipleResponses Boolean           @default(false)
  requireComment       Boolean            @default(false)
  settings             Json?
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  questions            FeedbackQuestion[]
  responses            FeedbackResponse[]
  feedbackRequests     FeedbackRequest[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([status])
  @@index([isPublic])
  @@index([deletedAt])
  @@map("feedback_forms")
}

model FeedbackQuestion {
  id                   String               @id @default(cuid())
  organizationId       String
  formId               String
  form                 FeedbackForm         @relation(fields: [formId], references: [id], onDelete: Cascade)
  questionType         FeedbackQuestionType @default(SHORT_TEXT)
  label                String
  description          String?
  placeholder          String?
  required             Boolean              @default(false)
  key                  String?
  options              String[]             @default([])
  validation           Json?
  sortOrder            Int                  @default(0)
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  answers              FeedbackAnswer[]

  @@index([formId])
  @@index([organizationId])
  @@map("feedback_questions")
}

model FeedbackRequest {
  id                   String                 @id @default(cuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  formId               String
  form                 FeedbackForm           @relation(fields: [formId], references: [id], onDelete: Cascade)
  ticketId             String
  ticket               Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  submittedById        String
  submittedBy          User                   @relation("FeedbackRequestSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  token                String                 @unique
  status               FeedbackRequestStatus  @default(PENDING)
  email                String?
  sentAt               DateTime?
  reminderSentAt       DateTime?
  openedAt             DateTime?
  submittedAt          DateTime?
  expiresAt            DateTime
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  responses            FeedbackResponse[]

  @@index([organizationId])
  @@index([formId])
  @@index([ticketId])
  @@index([submittedById])
  @@index([status])
  @@index([expiresAt])
  @@map("feedback_requests")
}

model FeedbackResponse {
  id                   String                 @id @default(cuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  formId               String
  form                 FeedbackForm           @relation(fields: [formId], references: [id], onDelete: Cascade)
  submittedById        String
  submittedBy          User                   @relation("FeedbackResponseSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  ticketId             String?
  ticket               Ticket?                @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  requestId            String?
  request              FeedbackRequest?       @relation(fields: [requestId], references: [id], onDelete: SetNull)
  status               FeedbackResponseStatus @default(SUBMITTED)
  publicComment        String?
  privateComment       String?
  ratings              Json?
  overallScore         Float?
  npsScore             Int?
  customerName         String?
  customerEmail        String?
  submittedAt          DateTime               @default(now())
  editedAt             DateTime?
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  answers              FeedbackAnswer[]

  @@index([formId])
  @@index([organizationId])
  @@index([submittedById])
  @@index([ticketId])
  @@index([requestId])
  @@index([submittedAt])
  @@map("feedback_responses")
}

model FeedbackAnswer {
  id                   String         @id @default(cuid())
  organizationId       String
  responseId           String
  response             FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId           String
  question             FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText           String?
  answerNumber         Float?
  answerBoolean        Boolean?
  answerDate           DateTime?
  answerOptions        String[]       @default([])
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([responseId, questionId])
  @@index([responseId])
  @@index([questionId])
  @@index([organizationId])
  @@map("feedback_answers")
}

// ==================================================
// KNOWLEDGE BASE
// ==================================================

model KnowledgeCategory {
  id                   String         @id @default(cuid())
  name                 String
  description          String?
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId             String?
  parent               KnowledgeCategory? @relation("CategoryParent", fields: [parentId], references: [id])
  children             KnowledgeCategory[] @relation("CategoryParent")
  order                Int            @default(0)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  articles             KnowledgeArticle[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("knowledge_categories")
}

model KnowledgeArticle {
  id                   String         @id @default(cuid())
  title                String
  slug                 String
  content              String
  excerpt              String?
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status               KnowledgeArticleStatus @default(DRAFT)
  visibility           KnowledgeArticleVisibility @default(PUBLIC)
  views                Int            @default(0)
  likes                Int            @default(0)
  helpfulCount         Int            @default(0)
  notHelpfulCount      Int            @default(0)
  createdById          String
  createdBy            User           @relation("ArticleCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedById          String?
  updatedBy            User?          @relation("ArticleUpdatedBy", fields: [updatedById], references: [id])
  publishedAt          DateTime?
  metadata             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  feedback             KnowledgeArticleFeedback[]
  tags                 KnowledgeArticleTag[]

  @@unique([slug, organizationId])
  @@index([organizationId])
  @@index([categoryId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@map("knowledge_articles")
}

model KnowledgeTag {
  id                   String         @id @default(cuid())
  name                 String
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  articles             KnowledgeArticleTag[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@map("knowledge_tags")
}

model KnowledgeArticleTag {
  id                   String         @id @default(cuid())
  articleId            String
  article              KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId                String
  tag                  KnowledgeTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([articleId, tagId])
  @@index([articleId])
  @@index([tagId])
  @@map("knowledge_article_tags")
}

model KnowledgeArticleFeedback {
  id                   String         @id @default(cuid())
  articleId            String
  article              KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  isHelpful            Boolean
  comment              String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([articleId, userId])
  @@index([articleId])
  @@index([userId])
  @@map("knowledge_article_feedback")
}

// ==================================================
// SUBSCRIPTIONS & BILLING
// ==================================================

model SubscriptionPlan {
  id                   String         @id @default(cuid())
  code                 String         @unique
  name                 String         @unique
  type                 PlanType       @unique
  description          String?
  priceMonthly         Decimal?
  priceYearly          Decimal?
  currency             String         @default("USD")
  features             Json           @default("{}")
  limits               Json           @default("{}")
  maxUsers             Int            @default(0)
  maxAgents            Int            @default(0)
  maxCustomers         Int            @default(0)
  maxTicketsPerMonth   Int            @default(0)
  maxFeedbackForms     Int            @default(0)
  maxAttachmentsPerTicket Int         @default(0)
  maxKnowledgeArticles Int            @default(0)
  maxInvitations       Int            @default(0)
  storageLimitBytes    BigInt         @default(0)
  apiMonthlyQuota      Int            @default(0)
  trialDays            Int            @default(14)
  sortOrder            Int            @default(0)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  subscriptions        OrganizationSubscription[]
  pendingSubscriptions OrganizationSubscription[] @relation("SubscriptionPendingPlan")
  featureLimits        FeatureLimit[]
  payments             Payment[]
  invoices             Invoice[]

  @@map("subscription_plans")
}

model OrganizationSubscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId               String
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  pendingPlanId        String?
  pendingPlan          SubscriptionPlan?  @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  status               SubscriptionStatus @default(TRIALING)
  billingInterval      BillingInterval    @default(MONTHLY)
  startDate            DateTime           @default(now())
  endDate              DateTime?
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  renewsAt             DateTime?
  cancelAt             DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  cancelledAt          DateTime?
  paymentProvider      PaymentProvider?
  providerSubscriptionId String?
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  usageRecords         UsageRecord[]
  payments             Payment[]
  invoices             Invoice[]

  @@index([organizationId])
  @@index([planId])
  @@index([pendingPlanId])
  @@index([status])
  @@index([endDate])
  @@index([currentPeriodEnd])
  @@map("organization_subscriptions")
}

model FeatureLimit {
  id                   String         @id @default(cuid())
  planId               String
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name                 String
  limit                Int
  description          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([planId, name])
  @@index([planId])
  @@map("feature_limits")
}

model UsageRecord {
  id                   String         @id @default(cuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId       String
  subscription         OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  metric               String
  value                Int            @default(0)
  periodStart          DateTime
  periodEnd            DateTime
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId])
  @@index([subscriptionId])
  @@index([metric])
  @@index([periodStart])
  @@map("usage_records")
}

model Payment {
  id                   String           @id @default(cuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId       String?
  subscription         OrganizationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId               String
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  reference            String           @unique
  idempotencyKey       String           @unique
  status               PaymentStatus    @default(PENDING)
  provider             PaymentProvider  @default(PAYCHANGU)
  amount               Decimal
  currency             String           @default("USD")
  providerTransactionId String?
  paymentMethod        String?
  receiptNumber        String?
  failureReason        String?
  paidAt               DateTime?
  metadata             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  invoice              Invoice?

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model Invoice {
  id                   String         @id @default(cuid())
  invoiceNumber        String         @unique
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId       String?
  subscription         OrganizationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId               String?
  plan                 SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  paymentId            String?        @unique
  payment              Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items                Json           @default("[]")
  amount               Decimal
  tax                  Decimal        @default(0)
  total                Decimal
  currency             String         @default("USD")
  status               InvoiceStatus  @default(PENDING)
  dueDate              DateTime?
  paidAt               DateTime?
  receiptReference     String?
  metadata             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

// ==================================================
// NOTIFICATIONS
// ==================================================

model Notification {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 NotificationType
  channel              NotificationChannel @default(IN_APP)
  priority             NotificationPriority @default(MEDIUM)
  title                String
  body                 String?
  data                 Json?
  relatedEntityType    String?
  relatedEntityId      String?
  deliveryStatus       NotificationDeliveryStatus @default(PENDING)
  errorMessage         String?
  scheduledAt          DateTime?
  expiresAt            DateTime?
  sentAt               DateTime?
  deliveredAt          DateTime?
  isRead               Boolean            @default(false)
  readAt               DateTime?
  isArchived           Boolean            @default(false)
  archivedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([isArchived])
  @@index([deliveryStatus])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 NotificationType
  channel              NotificationChannel
  isEnabled            Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
  @@map("notification_preferences")
}

model NotificationSettings {
  id                       String         @id @default(cuid())
  userId                   String
  user                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId           String?
  enableEmail              Boolean        @default(true)
  enableInApp              Boolean        @default(true)
  enableRealtime           Boolean        @default(true)
  enableTicketUpdates      Boolean        @default(true)
  enableFeedbackNotifications Boolean     @default(true)
  enableMarketingEmails    Boolean        @default(false)
  enableSecurityAlerts     Boolean        @default(true)
  quietHoursStart          String?
  quietHoursEnd            String?
  timezone                 String         @default("UTC")
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("notification_settings")
}

model NotificationTemplate {
  id                   String               @id @default(cuid())
  organizationId       String?
  organization         Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById          String
  createdBy            User                 @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  description          String?
  type                 String
  channel              NotificationChannel  @default(EMAIL)
  subject              String
  body                 String
  variables            String[]             @default([])
  status               NotificationTemplateStatus @default(ACTIVE)
  enabled              Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([slug, organizationId])
  @@index([organizationId])
  @@index([status])
  @@map("notification_templates")
}

model Announcement {
  id                   String             @id @default(cuid())
  organizationId       String?
  organization         Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById          String
  createdBy            User               @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  title                String
  body                 String
  type                 String             @default("ANNOUNCEMENT")
  priority             NotificationPriority @default(MEDIUM)
  audience             AnnouncementAudience @default(ALL)
  status               AnnouncementStatus @default(DRAFT)
  scheduledAt          DateTime?
  publishedAt          DateTime?
  expiresAt            DateTime?
  audienceTarget       Json?
  isGlobal             Boolean            @default(false)
  isActive             Boolean            @default(true)
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([organizationId])
  @@index([isGlobal])
  @@index([isActive])
  @@index([status])
  @@index([scheduledAt])
  @@index([expiresAt])
  @@map("announcements")
}

// ==================================================
// AUDIT & LOGGING
// ==================================================

model AuditLog {
  id                   String         @id @default(cuid())
  organizationId       String?
  organization         Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId              String?
  actor                User?          @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail           String?
  actorName            String?
  action               AuditAction
  entityType           String
  entityId             String?
  changes              Json?
  metadata             Json?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([organizationId])
  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model LoginHistory {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loginAt              DateTime       @default(now())
  ipAddress            String?
  userAgent            String?
  location             String?
  deviceInfo           String?
  isSuccessful         Boolean        @default(true)
  failureReason        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([loginAt])
  @@index([userId, loginAt])
  @@map("login_histories")
}

// ==================================================
// FILE STORAGE
// ==================================================

model FileUpload {
  id                   String         @id @default(cuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById         String
  uploadedBy           User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  originalName         String
  storedName           String         @unique
  mimeType             String
  fileSize             BigInt
  fileType             FileType
  bucket               String
  path                 String
  publicUrl            String?
  isPublic             Boolean        @default(false)
  metadata             Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  ticketAttachments    TicketAttachment[]
  evidence             Evidence[]

  @@index([organizationId])
  @@index([uploadedById])
  @@index([storedName])
  @@map("file_uploads")
}

// ==================================================
// SYSTEM & PLATFORM
// ==================================================

model SystemSetting {
  id                   String         @id @default(cuid())
  key                  String         @unique
  value                Json
  description          String?
  isEncrypted          Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("system_settings")
}

model SavedReport {
  id                   String         @id @default(cuid())
  name                 String
  description          String?
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById          String
  createdBy            User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  type                 String
  filters              Json
  columns              String[]
  schedule             Json?
  lastRunAt            DateTime?
  nextRunAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([organizationId])
  @@index([createdById])
  @@map("saved_reports")
}

model ApiKey {
  id                   String         @id @default(cuid())
  name                 String
  key                  String         @unique
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions          PermissionCode[]
  expiresAt            DateTime?
  lastUsedAt           DateTime?
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([key])
  @@index([userId])
  @@index([organizationId])
  @@index([isActive])
  @@map("api_keys")
}
