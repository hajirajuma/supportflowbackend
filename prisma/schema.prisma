}

model BusinessHours {
  id                   String           @id @default(cuid())
  name                 String
  description          String?
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                 BusinessHoursType @default(STANDARD)
