  createdBy            User             @relation("SLACreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedById          String?
  updatedBy            User?            @relation("SLAUpdatedBy", fields: [updatedById], references: [id])
  metadata             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  ticketSLAHistory     TicketSLAHistory[]

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([priority])
  @@index([status])
