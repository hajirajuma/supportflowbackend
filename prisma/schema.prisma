  @@index([ticketId])
  @@index([replyId])
  @@index([uploadedById])
  @@index([fileId])
  @@index([organizationId])
  @@index([isEvidence])
  @@map("ticket_attachments")
}

model TicketActivity {
  id                   String             @id @default(cuid())
  organizationId       String
  ticketId             String
  ticket               Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId              String?
