# ============================================================================
# SupportFlow Backend — Environment Configuration
# Copy this file to `.env` and fill in real values. All required variables are
# validated at boot by src/config/env.validation.ts (Joi).
# ============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Public base URL of this API (used for webhook callbacks)
API_URL=http://localhost:3001
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Frontend ----------------------------------------------------------------
# Comma-separated list of allowed CORS origins (no trailing slash)
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL, e.g. Neon) ----------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/supportflow?sslmode=require

# --- Auth / JWT ---------------------------------------------------------------
# Use long random strings: `openssl rand -hex 32`
JWT_SECRET=change-me-32-chars-minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-32-chars-minimum-too
JWT_REFRESH_EXPIRES_IN=7d

# --- Email (Brevo) ------------------------------------------------------------
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=SupportFlow <no-reply@yourdomain.com>

# --- Payments (PayChangu) -----------------------------------------------------
# sandbox | live — keys are REQUIRED when PAYCHANGU_ENV=live
PAYCHANGU_ENV=sandbox
PAYCHANGU_SECRET_KEY=
PAYCHANGU_PUBLIC_KEY=
PAYCHANGU_WEBHOOK_SECRET=
# Optional overrides (defaults to https://api.paychangu.com)
# PAYCHANGU_BASE_URL=
# PAYCHANGU_RETURN_URL=http://localhost:3000/billing/success
# PAYCHANGU_CALLBACK_URL=http://localhost:3001/api/v1/payments/webhook

# --- Storage (Supabase) -------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key
SUPABASE_BUCKET=supportflow

# --- Rate limiting (optional overrides) ---------------------------------------
# THROTTLE_TTL=60
# THROTTLE_LIMIT=100
